APP_NAME="Seconde Main 224"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Le site est servi sous /public : ne pas oublier ce suffixe.
APP_URL=https://natontine.com/public

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base MySQL créée depuis cPanel > Bases de données MySQL.
# Le préfixe (ex: cpanelUser_) est ajouté automatiquement par cPanel au nom
# de la base, de l'utilisateur et lors de l'association des deux.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpanelUser_secondmain
DB_USERNAME=cpanelUser_secondmain
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=.natontine.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail — SMTP LWS du compte noreply@natontine.com
# (cPanel > Comptes e-mail > Connect Devices > serveur sortant SMTP).
# Port 465 => MAIL_SCHEME=smtps ; si cPanel indique 587 => MAIL_PORT=587 et MAIL_SCHEME=null.
# L'expéditeur doit être le même compte que MAIL_USERNAME, sinon LWS peut refuser l'envoi.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.natontine.com
MAIL_PORT=465
MAIL_USERNAME=noreply@natontine.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@natontine.com"
MAIL_FROM_NAME="${APP_NAME}"

# Newsletter — e-mails envoyés par minute (5 = 300/heure).
# Rester sous la limite d'envoi horaire de l'offre LWS.
NEWSLETTER_PER_MINUTE=5

# Mentions légales (pages /confidentialite et /cgu)
LEGAL_COMPANY_NAME=
LEGAL_FORM=
LEGAL_RCCM=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_PHONE=

# Réseaux sociaux du pied de page (masqués si vides). WhatsApp : numéro au format 224620000000.
SOCIAL_FACEBOOK_URL=
SOCIAL_WHATSAPP_NUMBER=
SOCIAL_TWITTER_URL=

# Connexion Google — Google Cloud Console > API et services > Identifiants
# (ID client OAuth, type « Application Web »). L'URI de redirection ci-dessous
# doit être ajoutée telle quelle dans « URI de redirection autorisés ».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Notifications push (Firebase Cloud Messaging) — ID du projet Firebase.
# Déposer la clé du compte de service dans storage/app/private/firebase-service-account.json
# APRÈS avoir vérifié que https://natontine.com/storage/logs/laravel.log répond 403
# (protection par le .htaccess de la racine) ; sinon la clé serait téléchargeable.
FIREBASE_PROJECT_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Passerelle de paiement — désactiver le sandbox et renseigner les vraies clés.
DJOMY_CLIENT_ID=
DJOMY_CLIENT_SECRET=
DJOMY_SANDBOX=false
DJOMY_SANDBOX_URL=https://sandbox-api.djomy.africa

# Domaines autorisés pour l'auth Sanctum stateful (Blade + éventuel front séparé).
SANCTUM_STATEFUL_DOMAINS=natontine.com,www.natontine.com

VITE_APP_NAME="${APP_NAME}"

# Frontend Next.js (si déployé) — à mettre dans frontend/.env.local, pas ici :
#   NEXT_PUBLIC_API_BASE_URL=https://natontine.com/public/api/v1
#   NEXT_PUBLIC_GOOGLE_CLIENT_ID=<même Client ID que GOOGLE_CLIENT_ID>
#   (ne jamais mettre GOOGLE_CLIENT_SECRET dans le frontend)
