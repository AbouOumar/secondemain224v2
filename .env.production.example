APP_NAME="Seconde Main 224"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votredomaine.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base MySQL créée depuis cPanel > Bases de données MySQL.
# Le préfixe (ex: cpanelUser_) est ajouté automatiquement par cPanel au nom
# de la base, de l'utilisateur et lors de l'association des deux.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpanelUser_secondmain
DB_USERNAME=cpanelUser_secondmain
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=.votredomaine.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail — à adapter avec le SMTP fourni par LWS (cPanel > Comptes e-mail)
# ou un fournisseur tiers (ex: Brevo, Mailgun).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.votredomaine.com
MAIL_PORT=587
MAIL_USERNAME=contact@votredomaine.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@votredomaine.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Passerelle de paiement — désactiver le sandbox et renseigner les vraies clés.
DJOMY_CLIENT_ID=
DJOMY_CLIENT_SECRET=
DJOMY_SANDBOX=false
DJOMY_SANDBOX_URL=https://sandbox-api.djomy.africa

# Domaines autorisés pour l'auth Sanctum stateful (Blade + éventuel front séparé).
SANCTUM_STATEFUL_DOMAINS=votredomaine.com,www.votredomaine.com

VITE_APP_NAME="${APP_NAME}"
